# Project Aether Root Environment Example
# Copy to aether/backend/.env and configure your Gemini API key.
GOOGLE_API_KEY="YOUR_ACTUAL_GEMINI_API_KEY"
GEMINI_API_KEY="YOUR_ACTUAL_GEMINI_API_KEY"
GEMINI_LIVE_MODEL="gemini-3.8-live"
GEMINI_REASONING_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
DATABASE_URL="postgresql+asyncpg://aether:aether_secret_pass@localhost:5432/aether_companion"
REDIS_URL="redis://localhost:6379/0"
AETHER_API_TOKEN="aether-dev-local-token-2026"
HOST="0.0.0.0"
PORT="8000"
