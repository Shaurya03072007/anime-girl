# Google Gemini / ADK API Key (Required)
# Get yours from https://aistudio.google.com/apikey
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Gemini Models (Configurable — defaults to official supported Live & Flash models)
# If gemini-3.8-live is enabled on your account, set GEMINI_LIVE_MODEL="gemini-3.8-live"
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_REASONING_MODEL="gemini-2.5-flash"

# PostgreSQL + pgvector Connection URI
DATABASE_URL="postgresql+asyncpg://aether:aether_secret_pass@localhost:5432/aether_companion"

# Redis Connection URI (for ephemeral queues & proactive cooldowns)
REDIS_URL="redis://localhost:6379/0"

# Shared Bearer Token for Android Client <-> Backend WebSocket Authentication
AETHER_API_TOKEN="aether-dev-local-token-2026"

# Server Bind Host & Port
HOST="0.0.0.0"
PORT="8000"
